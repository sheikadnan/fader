<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Fader</string>
	<key>CFBundleIdentifier</key>
	<string>com.sheikadnan.fader</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Fader</string>
	<key>CFBundleDisplayName</key>
	<string>Fader</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>
	<!-- Menu bar only: no Dock icon, no Cmd-Tab entry. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!--
	  Fader reads other apps' audio through a Core Audio process tap in order to
	  apply a volume to it. Both keys are declared because the TCC service that
	  gates process taps has been reported under both names across macOS
	  releases; see README "Permissions".
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Fader reads each app's audio so it can apply your volume setting to it. Audio is never recorded, stored, or sent anywhere.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Fader reads each app's audio so it can apply your volume setting to it. Audio is never recorded, stored, or sent anywhere.</string>
</dict>
</plist>
